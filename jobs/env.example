# Settings for running the jobs on your own machine. Copy to %USERPROFILE%\.mip\.env (or set MIP_ENV_FILE).
# In GitHub Actions the same names come from the repo's secrets (see .github/workflows/fetch.yml).
# Every value is optional. Without keys the jobs use each source's anonymous limits.

# Contact declared to the SEC (required there) and to the polite pools (NCBI, OpenAlex).
CONTACT_EMAIL=

# Gemini API key (aistudio.google.com; the free tier is enough): headline tagging, document reading, catalog review.
LLM_API_KEY=
# LLM_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite     replace the model ladder built from the key's model list
# LLM_SEARCH_MODELS=gemini-3.5-flash                     models tried for Google Search grounding (default: the stable
#                                                        Flash and Flash-Lite models on the ladder, newest first)
# LLM_MIN_GAP_MS=4500                                    pause between two calls to the same model
# MIP_INTEL_INTERVAL_MIN=360   MIP_INTEL_MAX_MIN=12 (LLM minutes a run)   MIP_INTEL_MAX_DOCS=30   MIP_INTEL_SEC_BACKFILL_DAYS=365
# MIP_INTEL_NEWS_QUERIES=24 (GDELT queries a run)   MIP_INTEL_NEWS_DUE_H=20 (hours before an asset is searched again)
# MIP_INTEL_SEC_ASSETS=80 (assets searched on EDGAR a run)

# openFDA: 1,000 calls a day per IP address without a key, 120,000 with one. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# NCBI E-utilities: 3 calls a second without a key, 10 with one.
NCBI_API_KEY=
# OpenAlex: anonymous use is metered.
OPENALEX_API_KEY=

# MIP_HOME=C:\Users\<you>\.mip        disk cache, usage counters, llm-state.json and this .env
